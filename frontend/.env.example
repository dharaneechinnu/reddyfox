# Leave this unset for local dev — src/api.js then derives the backend's
# address from whatever host you used to load the page (localhost, this
# machine's LAN IP, or a phone on the same WiFi all work, with nothing to
# update when you switch networks), on the assumption the backend runs on
# the same machine at port 8000 (manage.py runserver's default).
#
# Set it explicitly here only to point at a backend that ISN'T on the same
# machine/port, and ALWAYS set it for a production build — frontend and
# backend are separate deployed origins there, so there is nothing to
# auto-detect. e.g.:
# VITE_API_BASE_URL=https://reddyforex-api.onrender.com/api


# --- Design previews --------------------------------------------------------
# Set to false to ignore /api/theme/ and render in the palette and type scale
# compiled into src/theme.css. Only for a preview build that points at a backend
# whose Theme row is production's — otherwise that row overrides the stylesheet
# and the preview shows the old colours. Leave unset in production, where staff
# need to change the theme from the admin without a rebuild.
# VITE_USE_THEME_API=false

# Set to true to also write dist/404.html as a copy of index.html. A host that
# serves 404.html for unmatched paths then hands every URL to the React router,
# which is what makes a preview deploy's inner pages load at all. It keeps the
# 404 status though, so a crawler is told every page is missing — NEVER set this
# in production. There, add a rewrite rule (/* -> /index.html) in the host's
# settings instead, which serves the app with a 200.
# VITE_SPA_404_FALLBACK=true


# --- Chrome browser push (rate alerts) --------------------------------------
# Leave these blank and the "Enable rate alerts" button simply never appears
# — the rest of the site is unaffected.
#
# To enable it: Firebase console -> Project settings -> General -> "Your
# apps" -> add a Web app, copy these values, and also generate a Web Push
# certificate under Cloud Messaging for VITE_FIREBASE_VAPID_KEY.
#
# These are public client identifiers, not secrets, but the service worker at
# public/firebase-messaging-sw.js can't read this file — copy the same
# values in there too (it has placeholders marked REPLACE_WITH_*).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
