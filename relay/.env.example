# Copy to .env for local runs (`node --env-file=.env server.js` on Node 20+,
# or export these into the shell yourself). On Render, set these as the
# service's environment variables instead — see docs/lead-relay.md.

PORT=8787

# Same bot token backend/telegram_alerts already uses. The relay needs its
# own copy as a plain env var — it must never fetch this from Django, since
# Django being unreachable is exactly the situation this exists to cover.
TELEGRAM_BOT_TOKEN=

# The desk's Telegram chat/group ID (numeric, from TelegramSubscriber in the
# Django admin, or from @userinfobot for a quick check).
TELEGRAM_DESK_CHAT_ID=

# Base URL of the real Django API, no trailing slash. The relay POSTs to
# ${DJANGO_API_BASE}/enquiries/, /quotes/, or /callbacks/ — same paths as
# backend/content/urls.py.
DJANGO_API_BASE=https://your-backend.onrender.com/api

# Comma-separated list of origins allowed to call this relay (the live site's
# own domain). Required — with this unset, every request is rejected, since
# an open relay can be used to spam the desk's Telegram for free.
ALLOWED_ORIGIN=https://reddyforex.example.com

# How long to keep retrying a single lead against Django before giving up
# and asking the desk to log it manually.
MAX_RETRY_HOURS=24
