SECRET_KEY=change-me
DEBUG=True
# Add this machine's LAN IP here too if you want to test from a phone/tablet
# on the same network, e.g. ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.4
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=foxexchange
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Same idea here — add http://<your-lan-ip>:<frontend-port> so the phone's
# browser is allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Absolute URL of this backend, used to build "open in admin" links in emails.
ADMIN_BASE_URL=http://localhost:8000

# --- Enquiry notifications -------------------------------------------------
# Default alert recipients (comma-separated). Per-type overrides for
# enquiries / quotes / rate locks live in the admin under Site settings; this
# is the fallback when one of those is left blank.
# Leave blank and leads are still saved — only the alert is skipped.
ENQUIRY_NOTIFY_EMAILS=reddyforex@gmail.com

# How many form submissions one IP may make per hour before being throttled.
# Shared across all three forms (enquiry, quote, rate lock).
ENQUIRY_THROTTLE_RATE=10/hour

# Leave EMAIL_HOST_USER blank in development: Django then prints alert emails
# to the console instead of sending them, so you can test with no credentials.
#
# To send for real via Gmail:
#   1. Enable 2-Step Verification on the Google account
#   2. Google Account -> Security -> App passwords -> generate one for "Mail"
#   3. Put the 16-character app password (not your Gmail password) below
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=reddyforex@gmail.com

# --- Team push notifications (Chrome, via FCM) — staff only, not customers --
# Leave these blank in development: staff can still "Enable push alerts" from
# the admin, and every send attempt is still logged in /admin/ (as FAILED,
# "FCM is not configured"), so the whole flow is testable with no Firebase
# project at all.
#
# To send real pushes:
#   1. Firebase console -> Project settings -> Service accounts -> Generate
#      new private key -> save the JSON file somewhere outside the repo ->
#      put its absolute path in FIREBASE_CREDENTIALS_JSON.
#   2. Firebase console -> Project settings -> General -> "Your apps" -> add
#      a Web app -> copy its config into the FIREBASE_WEB_* values below.
#   3. Cloud Messaging -> Web configuration -> generate a key pair -> put it
#      in FIREBASE_WEB_VAPID_KEY.
FIREBASE_CREDENTIALS_JSON=

# A staff subscriber notified within this many minutes is skipped on the next
# Normal-priority alert. Every new-enquiry alert is Urgent and always ignores
# this — a fresh lead should never be missed.
TEAM_ALERT_RATE_LIMIT_MINUTES=30

FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=
