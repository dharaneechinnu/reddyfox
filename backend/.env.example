SECRET_KEY=change-me
DEBUG=True
# Add this machine's LAN IP here too if you want to test from a phone/tablet
# on the same network, e.g. ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.4
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=foxexchange
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Same idea here — add http://<your-lan-ip>:<frontend-port> so the phone's
# browser is allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Absolute URL of this backend, used to build "open in admin" links in emails.
ADMIN_BASE_URL=http://localhost:8000

# --- Enquiry notifications -------------------------------------------------
# Who gets emailed when a website enquiry arrives (comma-separated).
# Leave blank and enquiries are still saved — only the alert is skipped.
ENQUIRY_NOTIFY_EMAILS=reddyforex@gmail.com

# How many enquiries one IP may submit per hour before being throttled.
ENQUIRY_THROTTLE_RATE=5/hour

# Leave EMAIL_HOST_USER blank in development: Django then prints alert emails
# to the console instead of sending them, so you can test with no credentials.
#
# To send for real via Gmail:
#   1. Enable 2-Step Verification on the Google account
#   2. Google Account -> Security -> App passwords -> generate one for "Mail"
#   3. Put the 16-character app password (not your Gmail password) below
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=reddyforex@gmail.com
