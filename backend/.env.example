SECRET_KEY=change-me
DEBUG=True
# Add this machine's LAN IP here too if you want to test from a phone/tablet
# on the same network, e.g. ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.4
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=foxexchange
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Same idea here — add http://<your-lan-ip>:<frontend-port> so the phone's
# browser is allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Absolute URL of this backend, used to build "open in admin" links in emails.
ADMIN_BASE_URL=http://localhost:8000

# --- Enquiry notifications -------------------------------------------------
# Default alert recipients (comma-separated). Per-type overrides for
# enquiries / quotes / rate locks live in the admin under Site settings; this
# is the fallback when one of those is left blank.
# Leave blank and leads are still saved — only the alert is skipped.
ENQUIRY_NOTIFY_EMAILS=reddyforex@gmail.com

# How many form submissions one IP may make per hour before being throttled.
# Shared across all three forms (enquiry, quote, rate lock).
ENQUIRY_THROTTLE_RATE=10/hour

# Leave EMAIL_HOST_USER blank in development: Django then prints alert emails
# to the console instead of sending them, so you can test with no credentials.
#
# To send for real via Gmail:
#   1. Enable 2-Step Verification on the Google account
#   2. Google Account -> Security -> App passwords -> generate one for "Mail"
#   3. Put the 16-character app password (not your Gmail password) below
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=reddyforex@gmail.com

# --- Chrome browser push (rate alerts via FCM) ------------------------------
# Leave blank in development: subscribers still register and every send
# attempt is still logged in /admin/ (as FAILED, "FCM is not configured"), so
# the whole flow is testable with no Firebase project at all.
#
# Accepts EITHER form, so whichever your host makes easy is fine:
#   - the service-account JSON itself, pasted in whole (what you want on
#     Render and most managed hosts, where an env var is all you get), or
#   - an absolute path to a file holding it (handy locally, or with a
#     Render Secret File).
#
# To send real pushes: Firebase console -> Project settings -> Service
# accounts -> Generate new private key, then paste the file's contents here
# or save it outside the repo and put its path here.
#
# Left empty, push is skipped cleanly and every send is logged as
# "not configured" — which is reported differently from a credential that is
# set but wrong, so the two are never confused in /admin/.
FIREBASE_CREDENTIALS_JSON=

# A subscriber notified within this many minutes is skipped on the next
# Normal-priority alert. Urgent alerts (big rate moves) always ignore this.
NOTIFICATION_RATE_LIMIT_MINUTES=60

# A currency's buy or sell rate moving by at least this many percent marks
# the alert Urgent instead of Normal.
RATE_ALERT_URGENT_THRESHOLD_PCT=1.0

# How many times one browser may (re)subscribe/unsubscribe per hour.
NOTIFICATION_SUBSCRIBE_THROTTLE_RATE=20/hour
