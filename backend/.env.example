SECRET_KEY=change-me
DEBUG=True
# ALLOWED_HOSTS and CORS_ALLOWED_ORIGINS below are ONLY used when DEBUG=False
# — with DEBUG=True (the default here), settings.py allows any host/origin,
# since local dev is reached from addresses that change with every network
# switch (this machine, its LAN IP, a phone on the same WiFi) and none of
# that is internet-facing. Set real values in both before deploying with
# DEBUG=False. See "Testing on a phone" in CLAUDE.md.
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=foxexchange
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Absolute URL of this backend, used to build "open in admin" links in emails.
ADMIN_BASE_URL=http://localhost:8000

# Staff-uploaded photos (Django admin -> Content -> Site images). Local disk
# storage, no third-party image host. Leave unset locally — these defaults
# are fine. In production (Render), MEDIA_ROOT MUST point at a mounted
# persistent disk, not the container's own filesystem, or every uploaded
# photo is deleted on the next deploy/restart.
# MEDIA_URL=/media/
# MEDIA_ROOT=/var/data/media

# --- Enquiry notifications -------------------------------------------------
# Default alert recipients (comma-separated). Per-type overrides for
# enquiries / quotes / callbacks live in the admin under Site settings; this
# is the fallback when one of those is left blank.
# Leave blank and leads are still saved — only the alert is skipped.
ENQUIRY_NOTIFY_EMAILS=reddyforex@gmail.com

# How many form submissions one IP may make per hour before being throttled.
# Shared across all three forms (enquiry, quote, callback).
ENQUIRY_THROTTLE_RATE=10/hour

# Leave EMAIL_HOST_USER blank in development: Django then prints alert emails
# to the console instead of sending them, so you can test with no credentials.
#
# To send for real via Gmail:
#   1. Enable 2-Step Verification on the Google account
#   2. Google Account -> Security -> App passwords -> generate one for "Mail"
#   3. Put the 16-character app password (not your Gmail password) below
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=reddyforex@gmail.com

# Reference rates (third-party mid-market rates, admin guidance only — see
# docs/currency-rate-apis.md). Populated by: python manage.py fetch_reference_rates
# How far a staff-entered sell_rate can diverge from the market reference (percent)
# before the admin flags it in red. Never blocks a save.
REFERENCE_RATE_DIVERGENCE_WARN_PCT=5.0
# A reference rate older than this many hours is shown as stale rather than trusted.
REFERENCE_RATE_STALE_AFTER_HOURS=48
# Primary reference-rate provider (exchangerate-api.com). Get a free key at
# https://www.exchangerate-api.com/ (1,500 requests/month free tier — our usage is ~60/month).
# Leave blank to skip it and fall back straight to fawazahmed0 (free, no key).
EXCHANGERATE_API_KEY=

# Telegram alert to admin-approved staff on every new lead, alongside the email alert. Get a
# token from @BotFather (see docs/telegram-bot.md). Blank skips the Telegram send entirely.
TELEGRAM_BOT_TOKEN=
# The bot's @username (no @, no https://t.me/) — needed to build the QR/deep-link invite in
# Django admin. Blank means the admin shows a hint to set this instead of a broken QR code.
TELEGRAM_BOT_USERNAME=
# How long an unscanned QR invite (Telegram alerts -> Telegram invites, admin) stays valid.
TELEGRAM_INVITE_EXPIRY_HOURS=24
# Webhook security — one secret, checked two ways: it's both the unguessable URL path segment
# and the value Telegram must echo back in a header on every real call. Obvious placeholder on
# purpose; a production deploy that forgot to set it is caught in review, not silently insecure.
# Generate a real value: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=changeme-set-a-real-webhook-secret
